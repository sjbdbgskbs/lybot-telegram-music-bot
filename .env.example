# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required for group voice chats: a Pyrogram user session string
TELEGRAM_USER_SESSION=

# Optional
BOT_NAME=LyBot
DATABASE_PATH=data/lybot.sqlite3
MAX_QUEUE_SIZE=50
SEARCH_RESULTS=8
LOG_LEVEL=INFO